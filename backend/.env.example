# Copy to .env for local development. This file contains no credentials.
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Set false to disable both /api/docs and /api/openapi.json.
API_DOCS_ENABLED=true

# Copy the current Aiven MySQL URI here; URL-encode reserved password characters.
DATABASE_URL=mysql://USER:PASSWORD@HOST:26464/defaultdb?ssl-mode=REQUIRED
DB_EXPECTED_DATABASE=defaultdb
DB_POOL_SIZE=5

# Local path is relative to backend when running npm run dev/start/db:check.
DB_SSL_CA_PATH="../Tai lieu he thong/ca.pem"
# Render: omit DB_SSL_CA_PATH and set DB_SSL_CA to the complete multiline CA PEM.
# Alternatively upload ca.pem as a Render Secret File and use:
# DB_SSL_CA_PATH=/etc/secrets/ca.pem (then omit DB_SSL_CA).
