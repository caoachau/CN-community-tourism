# Copy to backend/.env.test only when overriding local Docker test defaults.
# This file is never loaded by the API or Render.
TEST_DATABASE_URL=mysql://ctp_test:ctp_local_test_only@127.0.0.1:3307/ctp_test_control

# Docker publishes only on loopback. Change both the Compose port and URL together.
# TEST_MYSQL_PORT=3307

# A dedicated remote TEST server requires explicit opt-in and verified TLS.
# TEST_ALLOW_REMOTE_DATABASE=1
# TEST_DB_SSL_CA_PATH=/absolute/path/to/test-ca.pem
# Or TEST_DB_SSL_CA=<complete multiline PEM>; supply exactly one CA source.
