{
  "name": "@ctp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.js",
    "db:check:tls": "node --env-file-if-exists=.env scripts/check-database.js --negative-tests",
    "db:migrate:plan": "node --env-file-if-exists=.env scripts/migrate.js --plan",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js --apply",
    "db:migrate:verify": "node --env-file-if-exists=.env scripts/migrate.js --verify",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env.test scripts/run-integration-tests.js",
    "test:all": "npm test && npm run test:integration",
    "test:db:up": "docker compose -f test/docker-compose.yml up -d --wait --wait-timeout 180",
    "test:db:down": "docker compose -f test/docker-compose.yml down --volumes",
    "test:db:prepare": "node --env-file-if-exists=.env.test scripts/prepare-test-database.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
