{
  "name": "@ctp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.js",
    "db:check:tls": "node --env-file-if-exists=.env scripts/check-database.js --negative-tests",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/config/database.js && node --check src/database.js && node --check scripts/check-database.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
